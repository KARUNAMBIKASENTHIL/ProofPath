# ProofPath Environment Configuration Example

# Application
APP_NAME=ProofPath
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Tokens
SECRET_KEY=proofpath-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# If MongoDB is running locally or via Atlas, provide the connection string.
# Otherwise, ProofPath automatically uses its robust local file-backed embedded store.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=proofpath_db

# LLM & Embedding Providers (Optional)
# Supported providers: local-sentence-transformers, openai, gemini
EMBEDDING_PROVIDER=local-sentence-transformers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Third-Party Integrations (Optional)
GITHUB_ACCESS_TOKEN=
